---
const year = new Date().getFullYear();
import SocialIcon from './SocialIcon.astro';
---
<footer>
	<div class="footer-inner"><span>© {year} · Carnet d’ingénierie</span><div class="social-links" aria-label="Réseaux sociaux"><a href="https://github.com/thedasken" target="_blank" rel="noreferrer" aria-label="GitHub"><SocialIcon network="github" /><span class="sr-only">GitHub</span></a><a href="https://www.linkedin.com/in/clementfavarel/" target="_blank" rel="noreferrer" aria-label="LinkedIn"><SocialIcon network="linkedin" /><span class="sr-only">LinkedIn</span></a></div></div>
</footer>
<style>
footer { border-top: 1px solid var(--line); color: var(--muted); font-size: .78rem; }
.footer-inner { max-width: 1060px; margin: auto; padding: 1.1rem 1.5rem; display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
.social-links { display: flex; align-items: center; gap: .8rem; }
.social-links a { display: inline-flex; color: inherit; text-decoration: none; }
.social-links a:hover { color: var(--accent); }
@media (max-width: 600px) { .footer-inner { flex-wrap: wrap; } }
</style>
