---
import HeaderLink from './HeaderLink.astro';
import SocialIcon from './SocialIcon.astro';
---
<header class="site-header">
	<nav aria-label="Navigation principale">
		<a class="wordmark" href="/" aria-label="Carnet d’ingénierie, accueil"><svg class="mark" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="13" rx="2"/><path d="M8 21h8M12 17v4"/></svg><span>Carnet<span class="wordmark-light"> d’ingénierie</span></span></a>
		<div class="nav-links">
			<HeaderLink href="/">Accueil</HeaderLink>
			<HeaderLink href="/articles/">Articles</HeaderLink>
			<HeaderLink href="/about/">À propos</HeaderLink>
			<div class="social-links" aria-label="Réseaux sociaux">
				<a href="https://github.com/thedasken" target="_blank" rel="noreferrer" aria-label="GitHub"><SocialIcon network="github" /><span class="sr-only">GitHub</span></a>
				<a href="https://www.linkedin.com/in/clementfavarel/" target="_blank" rel="noreferrer" aria-label="LinkedIn"><SocialIcon network="linkedin" /><span class="sr-only">LinkedIn</span></a>
			</div>
		</div>
	</nav>
</header>
<style>
.site-header { border-bottom: 1px solid var(--line); }
nav { max-width: 1060px; min-height: 68px; margin: auto; padding: 0 1.5rem; display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
.wordmark { display: inline-flex; align-items: center; gap: .55rem; color: var(--ink); font-size: .96rem; font-weight: 650; letter-spacing: -.025em; text-decoration: none; white-space: nowrap; }
.mark { width: 1.2rem; height: 1.2rem; fill: none; stroke: var(--accent); stroke-linecap: round; stroke-linejoin: round; stroke-width: 1.8; }
.wordmark-light { color: var(--muted); font-weight: 450; }
.nav-links { display: flex; align-items: center; gap: 1.55rem; }
.nav-links :global(a) { color: var(--muted); font-size: .84rem; text-decoration: none; transition: color .15s; }
.nav-links :global(a:hover), .nav-links :global(a.active) { color: var(--ink); }
.nav-links :global(a.active) { font-weight: 600; }
.social-links { display: flex; align-items: center; gap: .8rem; }
.social-links a { display: inline-flex; color: var(--muted); }
.social-links a:hover { color: var(--accent); }
@media (max-width: 600px) { nav { align-items: flex-start; flex-direction: column; justify-content: center; gap: .45rem; padding: .8rem 1rem .75rem; } .nav-links { width: 100%; justify-content: space-between; gap: .4rem; } .nav-links :global(a) { font-size: .8rem; } }
</style>
