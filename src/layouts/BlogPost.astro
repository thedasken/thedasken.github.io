---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

type Props = CollectionEntry<'blog'>['data'];
const { title, description, pubDate, updatedDate, heroImage } = Astro.props;
---

<!doctype html>
<html lang="fr">
	<head><BaseHead title={`${title} — Carnet d’ingénierie`} description={description} image={heroImage} /></head>
	<body>
		<Header />
		<main class="article-shell">
			<article>
				<header class="article-heading">
					<a class="back-link" href="/articles/">← Tous les articles</a>
					<h1>{title}</h1>
					<p class="dek">{description}</p>
					<div class="article-meta"><span><FormattedDate date={pubDate} /></span>{updatedDate && <span>Mis à jour le <FormattedDate date={updatedDate} /></span>}</div>
				</header>
				{heroImage && <img class="hero-image" src={heroImage.src} alt="" />}
				<div class="prose"><slot /></div>
				<footer class="article-end"><span aria-hidden="true">∴</span><p>Fin de l’expérience</p><a href="/articles/">← Retour aux articles</a></footer>
			</article>
		</main>
		<Footer />
	</body>
</html>

<style>
	.article-shell { max-width: 780px; padding-top: 2.2rem; }
	.article-heading { padding: 1rem 0 2rem; }
	.back-link { color: var(--muted); font-size: .82rem; text-decoration: none; }
	.back-link:hover { color: var(--accent); }
	h1 { margin: 1.7rem 0 .7rem; font-size: clamp(2.4rem, 6.5vw, 4rem); font-weight: 550; line-height: 1.08; letter-spacing: -.06em; }
	.dek { max-width: 650px; margin: 0; color: var(--muted); font-size: 1.15rem; line-height: 1.65; }
	.article-meta { display: flex; flex-wrap: wrap; gap: .45rem 1rem; margin-top: 1.3rem; color: var(--muted); font: .75rem/1.5 var(--font-mono); }
	.hero-image { display: block; max-width: 100%; height: auto; margin: 0 0 2.4rem; border: 1px solid var(--line); }
	.article-end { display: grid; justify-items: center; margin: 3rem 0 1rem; padding: 1.4rem; border-top: 1px solid var(--line); color: var(--muted); text-align: center; }
	.article-end > span { color: var(--accent); font-size: 1.3rem; }
	.article-end p { margin: .35rem 0; font: .75rem var(--font-mono); }
	.article-end a { color: var(--muted); font-size: .85rem; text-decoration: none; }
	.article-end a:hover { color: var(--accent); }
	@media (max-width: 600px) { .article-shell { padding-top: 1.2rem; } .article-heading { padding-bottom: 1.5rem; } .dek { font-size: 1.03rem; } }
</style>
