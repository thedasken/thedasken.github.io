---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
const pageTitle = `Articles — ${SITE_TITLE}`;
const posts = (await getCollection('blog')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---
<!doctype html>
<html lang="fr">
<head><BaseHead title={pageTitle} description={SITE_DESCRIPTION} /></head>
<body><Header /><main class="archive"><header class="page-heading"><p class="section-label">LE CARNET</p><h1>Articles</h1><p>Expériences, analyses et notes sur les systèmes logiciels.</p></header>
{posts.length ? <ol class="post-list">{posts.map((post) => <li><a href={`/blog/${post.id}/`}><time><FormattedDate date={post.data.pubDate} /></time><div><h2>{post.data.title}</h2><p>{post.data.description}</p></div><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9" /></svg></a></li>)}</ol> : <p class="empty-state">Les premières expériences sont en préparation...</p>}
</main><Footer /></body>
</html>
<style>
.archive { max-width: 860px; min-height: 62vh; }
.page-heading { padding: 3.5rem 0 2rem; }
.page-heading h1 { margin: .6rem 0 .4rem; font-size: clamp(2.5rem, 6vw, 3.8rem); letter-spacing: -.06em; }
.page-heading > p:last-child { margin: 0; color: var(--muted); }
.section-label { margin: 0; color: var(--muted); font: 600 .72rem/1.4 var(--font-mono); letter-spacing: .09em; text-transform: uppercase; }
.post-list { margin: 0; padding: 0; list-style: none; border-top: 1px solid var(--line); }
.post-list li { border-bottom: 1px solid var(--line); }
.post-list a { display: grid; grid-template-columns: 120px 1fr 20px; gap: 1rem; padding: 1.25rem 0; color: inherit; text-decoration: none; }
time { padding-top: .3rem; color: var(--muted); font: .75rem/1.5 var(--font-mono); }
h2 { margin: 0; font-size: 1.2rem; font-weight: 550; letter-spacing: -.025em; }
.post-list p { margin: .3rem 0 0; color: var(--muted); font-size: .93rem; }
.post-list a > svg { width: 1rem; height: 1rem; color: var(--muted); fill: none; stroke: currentColor; stroke-linecap: round; stroke-linejoin: round; stroke-width: 1.8; }
.post-list a:hover h2, .post-list a:hover > svg { color: var(--accent); }
.empty-state { padding: 1.5rem 0; border-top: 1px solid var(--line); color: var(--muted); }
@media (max-width: 600px) { .page-heading { padding-top: 2.5rem; } .post-list a { grid-template-columns: 1fr 18px; gap: .2rem .8rem; } .post-list time { grid-column: 1; grid-row: 1; } .post-list a > div { grid-column: 1; grid-row: 2; } .post-list a > svg { grid-column: 2; grid-row: 1 / span 2; align-self: center; } }
</style>
